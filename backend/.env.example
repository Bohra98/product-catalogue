# Backend configuration. Copy to backend/.env for local runs:
#   cp backend/.env.example backend/.env
# Every value has a safe default, so the backend also starts with no .env at all.
# Never commit backend/.env (it is git-ignored).

# --- Server ---------------------------------------------------------------
PORT=4000
NODE_ENV=development
# Set to true behind a load balancer (e.g. AWS ALB) so rate limiting sees the client IP.
TRUST_PROXY=false

# --- Product data source ---------------------------------------------------
# fakestore = live https://fakestoreapi.com (no account or key needed)
# fixture   = bundled snapshot, fully offline, placeholder images
PRODUCT_SOURCE=fakestore
FAKESTORE_BASE_URL=https://fakestoreapi.com
FAKESTORE_TIMEOUT_MS=5000
FAKESTORE_IMAGE_TIMEOUT_MS=15000
FAKESTORE_CACHE_TTL_MS=300000

# --- Merchandising ---------------------------------------------------------
# Number of "top rated" products on the home page.
FEATURED_COUNT=5
# Number of "top rated" products at the top of a category page; the rest
# of the category is listed below them.
CATEGORY_FEATURED_COUNT=3

# --- Enquiry email -----------------------------------------------------------
# file    = write each email as a .eml file into MAIL_OUTBOX_DIR (default, no setup)
# console = log each email as JSON to stdout
# smtp    = send via SMTP (Mailpit in docker compose, Amazon SES SMTP in AWS)
MAIL_PROVIDER=file
MAIL_FROM=catalogue@example.com
SALES_INBOX=sales@example.com
MAIL_OUTBOX_DIR=./outbox

# Only used when MAIL_PROVIDER=smtp. Leave credentials empty for Mailpit.
# In AWS, inject SMTP_USER / SMTP_PASS from Secrets Manager, never from this file.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Max enquiries per client IP per minute.
ENQUIRY_RATE_LIMIT_PER_MINUTE=5
